[Unit]
Description=DataManager — background enrichment (embeddings, photo tags)
After=network-online.target remote-fs.target datamanager.service

[Service]
Type=oneshot
User=datamanager
Group=datamanager
WorkingDirectory=/opt/datamanager

# --wait holds until the machine is idle before starting, and the pass yields
# again the moment load comes back. That is the whole point of running this at
# 3am on a host doing other work: it never competes, it just takes longer.
#
# Resumable and idempotent — being killed mid-run costs only the item in
# flight, and the next run picks up where it stopped.
#
# Captions are NOT enabled: they need a vision model, which this container does
# not have and this host should not run. Add --captions only if you have
# pointed [llm] at an Ollama endpoint elsewhere (your Mac).
ExecStart=/opt/datamanager/.venv/bin/dm --config /etc/datamanager.toml enrich --wait

# Embeddings are the memory-hungry part. Without semantic extras installed
# this pass is nearly free, and this cap is simply never approached; with them
# it needs the headroom.
MemoryMax=2G

# Idle-class IO and the lowest nice value there is. This job has no deadline
# and nothing depends on it — it only makes things more findable.
Nice=19
IOSchedulingClass=idle

# Long, because --wait may spend most of it waiting for the host to go quiet.
TimeoutStartSec=14400

StandardOutput=journal
StandardError=journal
SyslogIdentifier=datamanager-enrich
