[Unit]
Description=Tracepaper — back up the human-authored layer
# The backup share is on the NAS, so this needs the mount to be there.
After=network-online.target remote-fs.target

[Service]
Type=oneshot
User=tracepaper
Group=tracepaper
WorkingDirectory=/opt/tracepaper

# Corrections, notes, entity and vocabulary merges -- the only state that
# cannot be regenerated by re-scanning the documents. Everything else in the
# index is a cache of what is already on the NAS.
#
# Deliberately not a copy of index.db. A SQLite file copied while the service
# has it open can be torn mid-transaction, and it would restore only into a
# schema-compatible build. A JSON export survives both.
ExecStart=/bin/sh -c 'exec /opt/tracepaper/.venv/bin/tracepaper --config /etc/tracepaper.toml backup "$${BACKUP_DIR}/corrections-$$(date +%%Y%%m%%d).json"'
Environment=BACKUP_DIR=/mnt/nas/backups/tracepaper

# Dated filenames, so a bad correction is recoverable from an older file rather
# than overwritten by the next night's run. They are small -- a few KB of JSON.
# Keep 30 days.
ExecStartPost=/bin/sh -c 'find "$${BACKUP_DIR}" -name "corrections-*.json" -mtime +30 -delete 2>/dev/null || true'

# A NAS that is unreachable must not leave this hanging until the next run.
TimeoutStartSec=600

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tracepaper-backup
