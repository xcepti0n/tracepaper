# Tracepaper — TLS termination.
#
# Installed to /etc/caddy/Caddyfile by deploy/caddy-install.sh, with the domain
# and upstream port substituted in. After editing by hand:
#   systemctl reload caddy
#
# Why a self-issued certificate: a name that resolves only inside your network
# (a local DNS rewrite pointing at the container) cannot be validated from
# outside, so no public CA will sign for it. Let's Encrypt says so themselves in
# "Certificates for localhost", and their advice for this case is to issue your
# own. `tls internal` does exactly that -- Caddy runs a small CA in the
# container, signs for this host, and renews indefinitely. Nothing leaves the
# LAN and there is no API token anywhere.
#
# The cost is trusting the CA root once per device -- see deploy/README.md.
#
# `tls internal` on its own issues 12-hour certificates and renews them every
# few hours. That is fine for a browser but miserable for anything pinning a
# cert, and it makes an outage look like an expiry every single day. The
# explicit `issuer internal` block below sets a 90-day lifetime, which is the
# normal figure people expect. The CA root itself is unaffected and lasts
# years, so trusting it once per device is still a one-time step.
#
# A leaf certificate can never outlive the CA that signed it, and Caddy's
# internal INTERMEDIATE defaults to 7 days. Asking for 90-day leaves alone
# silently gets you whatever is left of that week instead, so the global
# `pki` block below gives the intermediate a longer life. Without it the
# `lifetime` above is clamped and looks like it was ignored.
#
# The intermediate is set to 180d rather than 90d on purpose: it starts ageing
# immediately, so an equal figure would clamp the leaf again after the first
# day. It must be strictly longer than the leaf.
#
# There is deliberately no `log` directive. The Debian package runs Caddy under
# ProtectSystem=full, which remounts /var/log read-only, so pointing a log
# writer there fails at config load and Caddy exits before binding anything.
# The default is journald, where the rest of this stack already logs:
#   journalctl -u caddy -f

# Global options. The intermediate must outlive the certificates it signs.
{
	pki {
		ca local {
			intermediate_lifetime 180d
		}
	}
}

https://{$TRACEPAPER_DOMAIN} {
	tls {
		issuer internal {
			lifetime 90d
		}
	}

	encode zstd gzip

	# Documents can be large, and a scan of a big corpus makes the status
	# endpoints slow before the first results land. The default 100s read
	# timeout would cut those off mid-response.
	reverse_proxy 127.0.0.1:{$TRACEPAPER_PORT} {
		# Without this the app sees 127.0.0.1 as the client for every request.
		header_up X-Real-IP {remote_host}

		transport http {
			read_timeout 300s
		}
	}
}
