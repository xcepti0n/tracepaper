[Unit]
Description=Tracepaper - enrichment

[Timer]
# Hourly, not nightly. Each run is bounded (200 captions, and it yields when
# the machine is busy), so a once-a-day timer turned a 1,065 photo backlog
# into six days of waiting with nothing visibly happening in between. Hourly
# clears the same backlog overnight and costs nothing when there is no work:
# a run with nothing to do exits in seconds.
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
