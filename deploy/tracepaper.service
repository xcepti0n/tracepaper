[Unit]
Description=Tracepaper — deterministic search over personal documents
# remote-fs.target matters here in a way it does not for most services: the
# documents live on an NFS mount. Starting before it means the first scan sees
# an empty directory.
#
# Ordering only, never a hard dependency. A boot with the NAS unreachable
# should still bring the UI up — the index is local and stays searchable
# without the share, and the vanish guard already refuses to delete anything
# when the mount is missing (NFR-5).
After=network-online.target remote-fs.target
Wants=network-online.target

# These belong in [Unit], not [Service] — systemd ignores them in [Service],
# which would silently disable the crash-loop protection. Five failures inside
# a minute is not a transient fault; stop restarting and leave it visible in
# `systemctl status`.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=tracepaper
Group=tracepaper

WorkingDirectory=/opt/tracepaper
ExecStart=/opt/tracepaper/.venv/bin/tracepaper --config /etc/tracepaper.toml serve --host 0.0.0.0 --port 8823

Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tracepaper

# Hardening, limited to what an unprivileged LXC can actually do.
#
# The mount-namespace directives — ProtectSystem, PrivateTmp, PrivateDevices,
# ProtectHome, ProtectKernelTunables/Modules, ProtectControlGroups — all need to
# remount /proc, which an unprivileged container is not permitted to do. Setting
# them there hardens nothing: the unit fails to start at all, with
# status=226/NAMESPACE. They are the right settings on bare metal or a VM and
# the wrong ones inside this container.
#
# docs/DEPLOY.md shows ProtectSystem=strict for exactly that reason — it is
# written for a VM. This unit targets the LXC.
#
# What remains needs no namespace and still removes the paths that matter:
# privilege escalation, setuid abuse, and the kernel-facing capability surface.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

# Consequence of the empty capability set: this service cannot bind a port
# below 1024. 8823 is well clear of that. If you want :80 or :443, put a
# reverse proxy in front rather than granting CAP_NET_BIND_SERVICE back.

# The read-only guarantee (NFR-7) is enforced by the `ro` mount option in
# fstab, not here. ReadWritePaths needs a mount namespace, so it is unavailable
# in this container — and the mount option is the stronger control anyway: it
# applies to every process, including a scan you run by hand.

# A small Proxmox host with 16GB already doing other work. The service holds
# the SQLite connection and serves the UI; it does not embed, caption, or call
# a model, so its steady state is tens of MB. The cap turns a runaway query
# into a restart rather than an OOM that takes the container with it.
#
# Raise this if you enable semantic search inside the container: loading a
# sentence-transformers model needs roughly 1G on its own. The default install
# deliberately does not (see deploy/README.md).
MemoryMax=768M

# The model cache must be writable by the service user. HuggingFace defaults it
# to the working directory, which is root-owned by design -- so startup failed
# with EACCES on every boot and search silently fell back to keyword-only.
Environment=HF_HOME=/var/lib/tracepaper/hf-cache

# Never reach the network to resolve the model at startup. HF_HUB_OFFLINE makes
# a cached model load from disk and an absent one fail fast, instead of a HEAD
# request that delays binding the port past the health check's patience.
Environment=HF_HUB_OFFLINE=1

# One thread: the query path embeds a single short string per search, so extra
# workers only take CPU from whatever else is running.
Environment=OMP_NUM_THREADS=1

[Install]
WantedBy=multi-user.target
