[Unit]
Description=Tracepaper — background enrichment (embeddings, photo tags)
After=network-online.target remote-fs.target tracepaper.service

[Service]
Type=oneshot
User=tracepaper
Group=tracepaper
WorkingDirectory=/opt/tracepaper

# No --wait. It waited five minutes for the load average to fall, then gave up
# and exited reporting success -- "embedded=0 in 5s" with systemd logging
# Finished. A backlog never got embedded and nothing said so.
#
# Nice=19 and idle IO below are the honest version of the same intent: the
# kernel deprioritises this work at every scheduling decision, so it yields
# continuously instead of refusing to start, and it always makes progress.
#
# Resumable and idempotent. Being killed mid-run costs only the item in
# flight, and the next run picks up where it stopped.
#
# Captions follow the Settings page: this passes no flag, and enrich describes
# photos only when [llm] enabled is true and points at a vision model reachable
# from here, such as Ollama on another machine. Hardcoding --captions here would
# put the control in two places, and a timer that did not pass it was why the
# switch in the UI appeared to do nothing.
# Scan and enrich both write the index, and both now run hourly, so they will
# meet. They are NOT made mutually exclusive with Conflicts=: that stops one by
# KILLING the other, which loses a half-finished scan and is worse than
# waiting.
#
# flock serialises them instead. Whichever starts second blocks until the first
# finishes, then runs. Nothing is skipped and nothing is killed. The lock is a
# file in the state directory rather than /tmp, so it is not cleared under the
# service by something else, and -w bounds the wait: a job that cannot get the
# lock within an hour has hit something stuck, and failing loudly beats piling
# up runs that can never start.
ExecStart=/usr/bin/flock -w 3600 /var/lib/tracepaper/index.lock /opt/tracepaper/.venv/bin/tracepaper --config /etc/tracepaper/tracepaper.toml enrich

# Embeddings are the memory-hungry part. Without semantic extras installed
# this pass is nearly free, and this cap is simply never approached; with them
# it needs the headroom.
MemoryMax=2G

# The model cache must be somewhere the service user can write. HuggingFace
# defaults it to the working directory, which is root-owned by design, so the
# download failed with EACCES -- and was reported as "skipped", not an error.
# HOME is unset for a systemd service, so it defaults to WorkingDirectory:
# /opt/tracepaper, which is root-owned. Any library reaching for $HOME/.cache
# then fails with EACCES. HF_HOME does not cover this, because torch.hub uses
# $HOME/.cache unconditionally, and the failure surfaced only as a warning
# while search silently fell back to keyword-only.
# systemd creates these owned by User= before ExecStart, so the cache
# directories exist on a fresh install without an installer chown.
StateDirectory=tracepaper tracepaper/cache tracepaper/torch tracepaper/hf-cache
StateDirectoryMode=0750

Environment=HOME=/var/lib/tracepaper
Environment=XDG_CACHE_HOME=/var/lib/tracepaper/cache
Environment=TORCH_HOME=/var/lib/tracepaper/torch
Environment=HF_HOME=/var/lib/tracepaper/hf-cache

# PyTorch starts one worker per visible core and saturates the container,
# which starves the web service: Nice only helps when something else is
# runnable, and a request waiting on SQLite often is not. Cap the threads and
# the share so the UI stays reachable while a long backfill runs.
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
CPUQuota=150%

# Idle-class IO and the lowest nice value there is. This job has no deadline
# and nothing depends on it — it only makes things more findable.
Nice=19
IOSchedulingClass=idle

# Long, because a first backfill embeds the whole index -- millions of
# passages on a small CPU is hours, and Nice=19 makes it longer still.
TimeoutStartSec=14400

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tracepaper-enrich
